<?xml version="1.0"?>
<Devices>
	<SupportURL>https://github.com/eklundjon/indigo-anthem/wiki/Devices</SupportURL>
	<Device type="relay" id="AnthemMain">
		<Name>Anthem Main Zone</Name>
		<ConfigUI>
            <Field type="serialport" id="devicePortFieldId" />

			<Field type="button" id="checkPort">
				<Title>Connect</Title>
				<CallbackMethod>_queryDevice</CallbackMethod>
			</Field>
			
			<Field id="queryError" type="label" > </Field>
			<Field type="separator" id="simpleSeparator1" />
			<Field type="checkbox" id="querySuccessful" default="false" hidden="true"> </Field>
			
			<Field id="firmwareString" type="textfield"	readonly="YES">
				<Label>Device Version:</Label>
            </Field>

			<Field id="timeString" type="textfield"	readonly="YES">
				<Label>Device Time:</Label>
            </Field>

			<Field type="button" id="syncTime">
				<Title>Sync Time with Indigo</Title>
				<CallbackMethod>_syncTime</CallbackMethod>
			</Field>
			
			<Field id="Time24hr" type="textfield" readonly="YES" hidden="true"> </Field>

			<Field type="checkbox" id="enableExtendedInputs" default="false" hidden="true"> </Field>

		</ConfigUI>
		<States>
			<State id="input">
				<ValueType>
					<List>
						<Option value="TV">TV</Option>
					</List>
				</ValueType>
				<TriggerLabel>Active Input Changed</TriggerLabel>
				<TriggerLabelPrefix>Input Changed to</TriggerLabelPrefix>
				<ControlPageLabel>Active Input</ControlPageLabel>
			</State>
			<State id="volume">
				<ValueType>Integer</ValueType>
				<TriggerLabel>Current Volume</TriggerLabel>
				<TriggerLabelPrefix>Volume Changed to</TriggerLabelPrefix>
				<ControlPageLabel>Current Volume</ControlPageLabel>
			</State>
			<State id="mute">
				<ValueType boolType="YesNo">Boolean</ValueType>
				<TriggerLabel>Mute</TriggerLabel>
				<ControlPageLabel>Mute</ControlPageLabel>
			</State>
		</States>
	</Device>
</Devices>
